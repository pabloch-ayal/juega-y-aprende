<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_campo_cielo">

    <!-- 1. PANTALLA DE REGISTRO DE NOMBRE -->
    <LinearLayout
        android:id="@+id/screenSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/ic_abejita" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="¡Hola! ¿Cómo te llamas?"
            android:textColor="#1A237E"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChildName"
            android:layout_width="320dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_boton_blanco"
            android:gravity="center"
            android:hint="Escribe tu nombre aquí"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="18"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveName"
            android:layout_width="260dp"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#FF7043"
            android:text="¡Vamos a jugar! 🚀"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. PANTALLA MENÚ PRINCIPAL -->
    <LinearLayout
        android:id="@+id/screenMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <Button
                android:id="@+id/btnChangeName"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_blanco"
                android:paddingHorizontal="16dp"
                android:text="✏️ Cambiar nombre"
                android:textAllCaps="false"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Hola, Luciana! 🌟"
            android:textColor="#1A237E"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Elige qué quieres aprender hoy"
            android:textColor="#263238"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:id="@+id/cardColors"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_blanco"
                android:backgroundTint="#FF4081"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨"
                    android:textSize="64sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="12 Colores"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNumbers"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_boton_blanco"
                android:backgroundTint="#00BFA5"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔢"
                    android:textSize="64sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Números 1 al 10"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 3. PANTALLA DE APRENDIZAJE Y JUEGO -->
    <LinearLayout
        android:id="@+id/screenStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_boton_blanco"
                android:paddingHorizontal="16dp"
                android:text="🏠 Menú"
                android:textAllCaps="false"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/bannerInstruction"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cartel_voz"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊 "
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Toca cada color para aprender"
                    android:textColor="#212121"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleMode"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:backgroundTint="#43A047"
                android:paddingHorizontal="20dp"
                android:text="🎮 ¡A jugar!"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/stageGridContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ABEJITA GUÍA FLOTANTE -->
    <ImageView
        android:id="@+id/ivBeeGuide"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:elevation="12dp"
        android:src="@drawable/ic_abejita"
        android:visibility="gone" />

</FrameLayout>
